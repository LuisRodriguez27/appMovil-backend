NODE_ENV=development
PORT=3000
HOST=http://localhost

GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey-firebase.json
FIRESTORE_DATABASE_ID=(default)

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=2048
GEMINI_TEMPERATURE=0.7

# Ruta al archivo de credenciales de Service Account para Gemini Live API
# En desarrollo: usa la ruta local (./serviceAccountKey-gemini-live.json)
# En producción: establece la ruta absoluta o usa Google Application Default Credentials
# También soporta Base64: GEMINI_SERVICE_ACCOUNT_KEY=BASE64:<contenido-base64>
GEMINI_SERVICE_ACCOUNT_KEY=./serviceAccountKey-gemini-live.json

# ========================================
# WEBSOCKET (Voice & Chat)
# ========================================
# El WebSocket ahora usa el MISMO puerto que el servidor HTTP (PORT)
# No necesitas configurar un puerto separado
# Accesible en: ws://localhost:PORT/ws

