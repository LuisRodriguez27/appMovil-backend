NODE_ENV=development
PORT=3000
HOST=http://localhost

GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

FIRESTORE_DATABASE_ID=(default)

# Firebase Web API Key (para token refresh en testing)
# Obtén esta clave en: Firebase Console → Project Settings → Web API Key
# Ver guía completa en: docs/GET_FIREBASE_API_KEY.md
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE

# ========================================
# OTRAS CONFIGURACIONES
# ========================================

# JWT Secret (para autenticación futura)
# JWT_SECRET=tu_secret_super_seguro_aqui

# Redis (si lo usas)
# REDIS_HOST=localhost
# REDIS_PORT=6379
