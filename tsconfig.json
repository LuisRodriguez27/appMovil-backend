{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "es2017",
    "noImplicitAny": true,
    "moduleResolution": "node",
    "strictNullChecks": true,
    "sourceMap": false,
    "rootDir": ".",
    "strict": true,
    "noEmit": false,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "outDir": "./dist",
    "types": [
      "node",
      "jest"
    ]
  },
  "include": [
    "src/**/**.ts",
    "features/step_definitions/**/*",
    "test/**/**.ts",
    "src/app/config/service_account.json"
  ],
  "exclude": [
    "node_modules"
  ]
}
